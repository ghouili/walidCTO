# Absolute production URL (no trailing slash).
# Drives canonical URLs, hreflang, OG images, sitemap, robots, JSON-LD, llms.txt.
NEXT_PUBLIC_SITE_URL=https://walid.ghouili.com

# Contact + checklist forms (app/api/contact). Required in production:
# without it the form answers 503. In dev, messages are logged instead.
RESEND_API_KEY=
# Where leads go (defaults to the email in lib/site.ts).
CONTACT_TO=
# Sender on a domain verified in Resend, e.g. "Walid Ghouili <site@ghouili.com>".
# Without it Resend's test sender is used (delivers only to the account owner).
CONTACT_FROM=

# Google Tag Manager container (GTM-XXXXXXX). Enables the consent banner and
# loads GTM after consent. Leave empty for no analytics. Rebuild after changing.
NEXT_PUBLIC_GTM_ID=
